[
  { "id": "dev-pr-dot", "split": "development", "event": "pull_request_target", "with": { "ref": "${{ github.event.pull_request.head.sha }}" }, "expected": true, "reason": "The checkout selects the contributor's PR head commit in a privileged event." },
  { "id": "dev-pr-bracket", "split": "development", "event": "pull_request_target", "with": { "ref": "${{ github['event']['pull_request']['head']['sha'] }}" }, "expected": true, "reason": "Literal index syntax selects the same PR head commit as dot syntax." },
  { "id": "dev-head-ref", "split": "development", "event": "pull_request_target", "with": { "ref": "${{ github.head_ref }}" }, "expected": true, "reason": "head_ref is the contributor's source branch; selecting it crosses the checkout trust boundary." },
  { "id": "dev-run-sha", "split": "development", "event": "workflow_run", "with": { "ref": "${{ github.event.workflow_run.head_sha }}" }, "expected": true, "reason": "A workflow_run checkout of the triggering run's commit requires a trust review." },
  { "id": "dev-fork-repository", "split": "development", "event": "pull_request_target", "with": { "repository": "${{ github['event']['pull_request']['head']['repo']['full_name'] }}" }, "expected": true, "reason": "Selecting the PR author's repository can check out fork code even without an explicit ref." },
  { "id": "dev-pull-ref", "split": "development", "event": "pull_request_target", "with": { "ref": "refs/pull/17/head" }, "expected": true, "reason": "The explicit Git ref selects a PR head rather than a base branch." },
  { "id": "dev-default", "split": "development", "event": "pull_request_target", "with": {}, "expected": false, "reason": "No PR/run-head selection appears; the privileged-trigger hint is separate." },
  { "id": "dev-base-sha", "split": "development", "event": "pull_request_target", "with": { "ref": "${{ github.event.pull_request.base.sha }}" }, "expected": false, "reason": "The base commit is not the contributor head targeted by this rule." },
  { "id": "dev-path-context", "split": "development", "event": "pull_request_target", "with": { "path": "github.event.pull_request.head" }, "expected": false, "reason": "A destination directory does not select a checkout repository or revision." },
  { "id": "dev-path-pull", "split": "development", "event": "pull_request_target", "with": { "path": "review/refs/pull/17/head" }, "expected": false, "reason": "A directory containing a PR-ref substring does not select PR code." },
  { "id": "dev-plain-context", "split": "development", "event": "pull_request_target", "with": { "ref": "github.event.pull_request.head.ref" }, "expected": false, "reason": "Outside an expression this is a literal ref name, not an event property lookup." },
  { "id": "dev-literal-expression", "split": "development", "event": "pull_request_target", "with": { "ref": "${{ 'github.event.pull_request.head.ref' }}" }, "expected": false, "reason": "The expression returns a constant string rather than a PR field." },
  { "id": "confirm-mixed-index", "split": "confirmation", "event": "pull_request_target", "with": { "ref": "${{ github.event['pull_request'].head['ref'] }}" }, "expected": true, "reason": "Mixed index and dot syntax still selects a contributor branch." },
  { "id": "confirm-run-branch", "split": "confirmation", "event": "workflow_run", "with": { "ref": "${{ github['event']['workflow_run']['head_branch'] }}" }, "expected": true, "reason": "Index syntax selects the branch from the triggering workflow run." },
  { "id": "confirm-format-head", "split": "confirmation", "event": "pull_request_target", "with": { "ref": "${{ format('{0}', github.event.pull_request.head.sha) }}" }, "expected": true, "reason": "Wrapping an actual PR head property in format does not remove its provenance." },
  { "id": "confirm-merge-ref", "split": "confirmation", "event": "pull_request_target", "with": { "ref": "refs/pull/${{ github.event.number }}/merge" }, "expected": true, "reason": "A PR merge ref also includes contributor code and requires review." },
  { "id": "confirm-unprivileged", "split": "confirmation", "event": "pull_request", "with": { "ref": "${{ github['event']['pull_request']['head']['sha'] }}" }, "expected": false, "reason": "This rule specifically concerns privileged triggers; no finding is not a general safety claim." },
  { "id": "confirm-other-action", "split": "confirmation", "event": "pull_request_target", "uses": "example/review-action@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "with": { "ref": "${{ github.event.pull_request.head.sha }}" }, "expected": false, "reason": "External actions are not expanded and this is not actions/checkout." },
  { "id": "confirm-base-index", "split": "confirmation", "event": "pull_request_target", "with": { "ref": "${{ github['event']['pull_request']['base']['ref'] }}", "repository": "${{ github.event.pull_request.base.repo.full_name }}" }, "expected": false, "reason": "Both selectors refer to the base repository, not the contributor's head." },
  { "id": "confirm-format-literal", "split": "confirmation", "event": "pull_request_target", "with": { "ref": "${{ format('github.event.pull_request.head.{0}', 'ref') }}" }, "expected": false, "reason": "Context-looking text in format string literals does not read the PR object." }
]
