{
  "name": "@sreyasts/workflow-lens",
  "version": "0.1.1",
  "description": "CLI for generating local GitHub Actions dependency maps and workflow review reports.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "workflow-lens": "bin/workflow-lens.js"
  },
  "files": [
    "dist/cli/cli.js",
    "bin",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sreyasts/workflow-lens.git"
  },
  "homepage": "https://sreyasts.github.io/workflow-lens/",
  "bugs": {
    "url": "https://github.com/sreyasts/workflow-lens/issues"
  },
  "keywords": [
    "github-actions",
    "workflow",
    "permissions",
    "pull-request",
    "cli",
    "mermaid",
    "visualization",
    "devops"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --base=./ && vite build --ssr src/cli.ts --outDir dist/cli --emptyOutDir false",
    "test": "node --test tests/*.test.ts",
    "evaluate": "node scripts/evaluate.ts",
    "evaluate:compare": "node scripts/compare-evaluation.ts",
    "evaluate:permissions": "node scripts/evaluate-public-permissions.ts",
    "test:e2e": "playwright test",
    "inspect": "node bin/workflow-lens.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
